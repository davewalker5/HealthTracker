<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Health Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/datatables.min.css" />
    <script src="~/lib/jquery/dist/jquery.js" type="text/javascript"></script>
    <script src="~/lib/jquery-confirm/jquery-confirm.js" type="text/javascript"></script>
    <script src="~/lib/jquery-fxtime/dist/jquery-fxtime.js" type="text/javascript"></script>
</head>
<body>
    <div class="app-shell">
        <header class="app-header">
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="app-container">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Health Tracker home">
                        <span class="brand-mark" aria-hidden="true"><i class="fas fa-heartbeat"></i></span>
                        <span class="brand-copy">
                            <strong>Health Tracker</strong>
                            <small>Personal health record</small>
                        </span>
                    </a>
                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse">
                        <ul class="navbar-nav ml-auto">
                            @if (User?.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="PersonMedication" asp-action="Index">Medications</a>
                                </li>

                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="mealPlannerMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Meal Planner
                                    </a>
                                    <div class="dropdown-menu" aria-labelledby="mealPlannerMenu">
                                        <a class="dropdown-item" asp-area="" asp-controller="PlannedMeal" asp-action="Index">Meal Planner</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="MealSearch" asp-action="Index">Meal Search</a>
                                    </div>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="measurementsMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Measurements
                                    </a>
                                    <div class="dropdown-menu" aria-labelledby="measurementsMenu">
                                        <a class="dropdown-item" asp-area="" asp-controller="BloodOxygenSaturation" asp-action="Index">% SPO2</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="BeverageConsumption" asp-action="Index">Beverage Consumption</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="BloodPressure" asp-action="Index">Blood Pressure</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="Exercise" asp-action="Index">Exercise</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="BloodGlucose" asp-action="Index">Glucose</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="MealConsumption" asp-action="Index">Meal Consumption</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="Weight" asp-action="Index">Weight</a>
                                    </div>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="referenceDataMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Reference Data
                                    </a>
                                    <div class="dropdown-menu" aria-labelledby="referenceDataMenu">
                                        <a class="dropdown-item" asp-area="" asp-controller="Alcohol" asp-action="Index">Alcohol Calculator</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="ReferenceData" asp-action="BloodPressureBands">Blood Pressure Bands</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="ReferenceData" asp-action="BMIBands">BMI Bands</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="ReferenceData" asp-action="BloodOxygenSaturationBands">% SPO2 Bands</a>
                                    </div>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="maintenanceMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Data Maintenance
                                    </a>
                                    <div class="dropdown-menu" aria-labelledby="maintenanceMenu">
                                        <a class="dropdown-item" asp-area="" asp-controller="ActivityType" asp-action="Index">Activity Types</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="Beverage" asp-action="Index">Beverages</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="BeverageMeasure" asp-action="Index">Beverage Measures</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="FoodCategory" asp-action="Index">Food Categories</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="FoodItem" asp-action="Index">Food Items</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="FoodSource" asp-action="Index">Food Sources</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="Meal" asp-action="Index">Meals</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="Medication" asp-action="Index">Medications</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="Person" asp-action="Index">People</a>
                                    </div>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="jobsMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Jobs
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="jobsMenu">
                                        <a class="dropdown-item" asp-area="" asp-controller="Import" asp-action="Index">Import</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="JobStatus" asp-action="Index">Job Status</a>
                                    </div>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Login" asp-action="LogOut">Log Out</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Login" asp-action="Index">Log In</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <div class="app-container app-content">
            <div class="page-heading">
                <div>
                    <p class="eyebrow">Health Tracker</p>
                    <h1>@ViewData["Title"]</h1>
                </div>
            </div>
            <main role="main">
                @RenderBody()
                @await Html.PartialAsync("_AjaxModalDialog")
            </main>
        </div>

        <footer class="app-footer">
            <div class="app-container footer-content">
                <span><i class="fas fa-heartbeat" aria-hidden="true"></i> Health Tracker @ViewData["Version"]</span>
                <span>&copy; 2024-2026 David Walker</span>
            </div>
        </footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/datatables.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
