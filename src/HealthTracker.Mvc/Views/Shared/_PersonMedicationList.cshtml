@using HealthTracker.Mvc.Entities
@model HealthTracker.Mvc.Models.PersonMedicationListViewModel

@functions
{
    public string GetRowClass(bool isActive, int daysRemaining)
    {
        if (!isActive)
        {
            return "medication-row medication-row--inactive";
        }
        else if (daysRemaining <= Model.Settings.MedicationDaysRemainingCriticalDays)
        {
            return "medication-row medication-row--critical";
        }
        else if (daysRemaining <= Model.Settings.MedicationDaysRemainingWarningDays)
        {
            return "medication-row medication-row--warning";
        }
        else
        {
            return "medication-row";
        }
    }
}

<div class="table-shell">
<table class="table">
    <tr>
        <th/>
        <th>Person</th>
        <th>Medication</th>
        <th>Active</th>
        <th>Stock</th>
        <th>Daily Dose</th>
        <th>Last Taken</th>
        <th>Days Left</th>
        <th>Last Day</th>
        <th>Order More</th>
        <th>Actions</th>
        @if (Model.Editable)
        {
            <th />
            <th />
        }
    </tr>
    @foreach (var association in Model.Associations)
    {
        var lastDay = association.LastDay();
        var orderMore = association.OrderMoreDate(Model.Settings.MedicationOrderLeadTimeDays);
        var lastTaken = association.LastTaken.HasValue ? association.LastTaken.Value.ToString(DateFormats.Date) : "-";
        var lastDayString = lastDay.HasValue ? lastDay.Value.ToString(DateFormats.Date) : "-";
        var orderMoreString = orderMore.HasValue ? orderMore.Value.ToString(DateFormats.Date) : "-";
        var active = association.Active ? "Yes" : "No";
        var actions = association.Active ? string.Join(", ", association.Actions ?? []) : "";
        var rowClass = GetRowClass(association.Active, association.DaysRemaining());

        <tr class="@rowClass">
            <td valign="center">
                @if (Model.Editable && association.Active)
                {
                    @Html.CheckBox($"Selected_{association.Id}")
                }
            </td>
            <td valign="center">@Model.Filters.SelectedPerson.Name</td>
            <td valign="center">@association.Medication.Name</td>
            <td valign="center">@active</td>
            <td valign="center">@association.Stock</td>
            <td valign="center">@association.DailyDose</td>
            <td valign="center">@lastTaken</td>
            <td valign="center">@association.DaysRemaining()</td>
            <td valign="center">@lastDayString</td>
            <td valign="center">@orderMoreString</td>
            <td valign="center">@actions</td>
            @if (Model.Editable)
            {
                <td valign="center">
                    <a class="btn btn-lg" asp-area="" asp-controller="PersonMedication" asp-action="Edit" asp-route-id="@association.Id">
                        <i class="fas fa-edit"></i>
                    </a>
                </td>
                <td valign="center">
                    <a class="btn btn-lg" href="javascript:submitDeleteForm(@association.Id)">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
                }
        </tr>
    }
</table>
</div>
